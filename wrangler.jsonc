{
  "name": "date-invitation-email",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "SITE_ORIGIN": "https://ruokei.github.io",
    "MAIL_FROM": "Our Little Universe <invitation@exy.rest>"
  },
  "ratelimits": [
    {
      "name": "SEND_RATE",
      "namespace_id": "61072601",
      "simple": { "limit": 3, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE",
      "namespace_id": "61072602",
      "simple": { "limit": 10, "period": 60 }
    }
  ]
}
